tools/MuChilaAdmin/bin/
tools/MuChilaAdmin/obj/

# Pacotes gerados para distribuicao (o cliente vai descompactado no repositorio)
*.zip

# Arquivos de pasta do Windows
desktop.ini
Thumbs.db

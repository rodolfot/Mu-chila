# Logs gerados pelos servidores, pelo launcher e pelo cliente
**/LOG/
**/LOG_ACCOUNT/
**/CONNECT_LOG/
**/HACK_LOG/
**/BANNED_IP/*.txt
**/Logs/
*.log

# Backups temporarios criados durante as alteracoes (o historico do git substitui)
*.bak-*

# Backups de dados de jogadores gerados pelas ferramentas (ficam so em C:\MuServer\DB)
backup-caixas-*.csv
backup-itens-*.csv

# Saida de compilacao do painel (a versao publicada fica em C:\MuServer\MuChilaAdmin)
tools/MuChilaAdmin/bin/
tools/MuChilaAdmin/obj/
tools/MuChilaAdmin.Core/bin/
tools/MuChilaAdmin.Core/obj/
tools/MuChilaAdmin.Testes/bin/
tools/MuChilaAdmin.Testes/obj/
# Tailwind CSS baixado pelo Preparar-Ambiente-Dev.ps1 (o CSS gerado, wwwroot/css/app.css, fica no repositório)
tools/MuChilaAdmin/.ferramentas/
# configuração local do painel (banco, pastas, porta): fica em %ProgramData%\MuChilaAdmin, nunca no repositório
muchila-admin.json

# Pacotes gerados para distribuicao (o cliente vai descompactado no repositorio)
*.zip

# Arquivos de pasta do Windows
desktop.ini
Thumbs.db

# Site: senhas e dados locais (nunca no repositorio publico)
**/Site/config-local/
**/Site/tmp/
**/Site/apache/
**/Site/php/
**/Site/www/includes/cache/
**/includes/config/webengine.json
*.original

# Despejos de memoria de queda dos servidores (podem ter dados de contas)
*.dmp

# registro de pontos dados pelo painel (nomes de contas; fica só no servidor)
**/DB/muchila-pontos-dados.csv

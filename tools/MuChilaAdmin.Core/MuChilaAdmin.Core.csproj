<Project Sdk="Microsoft.NET.Sdk">

  <!-- Núcleo do Mu Chila Admin: banco, arquivos do servidor, vigia e regras do painel. Sem tela: quem mostra é o painel web
       (projeto MuChilaAdmin). Windows porque conversa com as janelas e a memória dos servidores. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WPF só para as bibliotecas de UI Automation (controle do launcher "Ligar Servidor") -->
    <UseWPF>true</UseWPF>
    <RootNamespace>MuChilaAdmin.Core</RootNamespace>
    <AssemblyName>MuChilaAdmin.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MuChilaAdmin" />
    <InternalsVisibleTo Include="MuChilaAdmin.Testes" />
  </ItemGroup>

</Project>

@page "/monstros/atributos"
@attribute [Authorize(Policy = Politicas.Administrar)]
@implements IDisposable
@inject ExecutorAcoes Acoes
@inject Confirmacao Confirmar
@inject Avisos Toast
@inject NavigationManager Nav
@inject RecargaMonstros Recarga

<CabecalhoPagina Titulo="Atributos dos monstros" Descricao="Vida, dano, defesa, velocidade, visão, tempo para renascer, resistências e os poderes (o que o monstro solta) de cada monstro (Data\Monster)." Icone="skull" />

<Nota Tipo="info" Classe="mb-5">
    Vale para todos os monstros daquele tipo, em todos os mapas, depois do Reload Monster (se houver uma invasão no ar, o painel espera ela acabar).
    As taxas de drop ficam na página <a class="link" href="drops">Drops</a>.
</Nota>

<div class="grid grid-cols-1 gap-5 xl:grid-cols-[19rem_minmax(0,1fr)]">
    <Cartao Titulo="Monstros" Icone="skull" SemPadding="true" Subtitulo="@($"{monstros.Count} no Monster.txt")">
        <div class="border-b border-slate-200 p-3 dark:border-white/10">
            <input class="entrada entrada-sm" placeholder="Filtrar por nome, número ou nível..." @bind="filtro" @bind:event="oninput" aria-label="Filtrar monstro" />
        </div>
        <ul class="rolagem max-h-[34vh] divide-y divide-slate-100 xl:max-h-[70vh] dark:divide-white/5">
            @foreach (var m in Filtrados())
            {
                <li>
                    <button type="button" class="flex w-full items-center gap-3 px-4 py-2 text-left text-sm @(atual?.Index == m.Index ? "bg-amber-50 dark:bg-amber-400/10" : "hover:bg-slate-50 dark:hover:bg-white/5")" @onclick="() => Abrir(m)">
                        <span class="mono text-slate-400">@m.Index</span>
                        <span class="min-w-0 flex-1 truncate font-medium text-slate-800 dark:text-slate-200">@m.Nome</span>
                        <span class="text-xs tabular-nums text-slate-500" title="nível">nv @m.Valores[3]</span>
                    </button>
                </li>
            }
        </ul>
    </Cartao>

    <div class="min-w-0 space-y-5">
        @if (atual == null || editado == null)
        {
            <Cartao><Vazio Texto="Escolha um monstro." Icone="skull" /></Cartao>
        }
        else
        {
            <Cartao Titulo="@($"{atual.Index} · {atual.Nome}")" Icone="skull" Subtitulo="@($"nível {atual.Valores[3]} · {poderesEdit.Count} poder(es)")">
                <Etiqueta>
                    @if (Mudou)
                    {
                        <span class="etiqueta etq-amarela">não salvo</span>
                    }
                </Etiqueta>
                <Acoes>
                    <button type="button" class="btn btn-secundario btn-sm" @onclick="Descartar" disabled="@(!Mudou || ocupado)">Descartar</button>
                    <button type="button" class="btn btn-primario btn-sm" @onclick="Salvar" disabled="@(!Mudou || ocupado)"><Icone Nome="save" Classe="h-3.5 w-3.5" />Salvar e recarregar</button>
                </Acoes>
                <ChildContent>
                    <div class="space-y-6">
                        @foreach (var g in MonsterStats.Campos.GroupBy(c => c.Grupo))
                        {
                            <section>
                                <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">@g.Key</h3>
                                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                                    @foreach (var c in g)
                                    {
                                        var campo = c;
                                        bool diferente = editado.Valor(campo) != atual.Valor(campo);
                                        <label class="block">
                                            <span class="rotulo">@campo.Nome</span>
                                            <input type="number" min="@campo.Min" max="@campo.Max" class="entrada entrada-sm @(diferente ? "ring-2 ring-amber-400/60" : "")" value="@editado.Valor(campo)"
                                                   @onchange="e => Mudar(campo, e)" aria-label="@campo.Nome" />
                                            <span class="ajuda">@(diferente ? $"era {atual.Valor(campo):N0}" : campo.Ajuda)</span>
                                        </label>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </ChildContent>
            </Cartao>

            <Cartao Titulo="Poderes especiais" Icone="zap" Subtitulo="O que o monstro solta (Data\Monster\Skill). Uma unidade/efeito usado por vários monstros muda em todos.">
                <ChildContent>
                    @if (atual != null && skills.MonstrosQueSoltam.Contains(atual.Index))
                    {
                        <Nota Tipo="sucesso" Classe="mb-4">
                            <b>Este monstro solta skill de verdade.</b> Ajustar a skill, a área, o intervalo e os efeitos abaixo funciona — o GameServer faz ele soltar (depois de reiniciar).
                        </Nota>
                    }
                    else
                    {
                        var soltam = monstros.Where(m => skills.MonstrosQueSoltam.Contains(m.Index)).Select(m => m.Nome).Distinct().ToList();
                        <Nota Tipo="atencao" Classe="mb-4">
                            <b>Pelos testes, este monstro NÃO solta skill no servidor.</b> Por mais que você configure e reinicie, ele fica no ataque normal — não é a config, é o GameServer que só liga a "IA de soltar skill" para monstros específicos. No kit, só estes @soltam.Count soltam: <b>@string.Join(", ", soltam)</b>. Para um poder que funcione, edite um desses.
                        </Nota>
                    }
                    @if (poderesEdit.Count == 0)
                    {
                        <p class="mb-3 text-sm text-slate-500">Este monstro só tem o ataque normal (nenhum poder). Adicione um abaixo.</p>
                    }
                    <div class="space-y-4">
                        @for (int pi = 0; pi < poderesEdit.Count; pi++)
                        {
                            var i = pi;
                            var poder = poderesEdit[i];
                            var u = UnidadeEdit(poder.Unidade);
                            <div class="rounded-lg border border-slate-200 p-3 dark:border-white/10">
                                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                                    <label class="flex min-w-0 flex-1 items-center gap-2">
                                        <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-500">Skill</span>
                                        <select class="entrada entrada-sm min-w-0 flex-1 font-medium" @onchange="e => TrocarSkill(i, e)" aria-label="Skill do poder">
                                            @foreach (var s in SkillsOrdenadas)
                                            {
                                                <option value="@s.Key" selected="@(s.Key == poder.Tipo)">@s.Value</option>
                                            }
                                            @if (!skills.SkillsDeMonstro.Contains(poder.Tipo))
                                            {
                                                <option value="@poder.Tipo" selected>@MonsterSkills.NomeSkill(poder.Tipo, skills) — ⚠ não soltada por monstros</option>
                                            }
                                        </select>
                                    </label>
                                    <button type="button" class="btn btn-fantasma btn-icone text-rose-500" title="Remover poder" @onclick="() => RemoverPoder(i)"><Icone Nome="trash" Classe="h-4 w-4" /></button>
                                </div>
                                @if (u == null)
                                {
                                    <p class="text-xs text-rose-500">Configuração @poder.Unidade não está no MonsterSkillUnit.txt.</p>
                                }
                                else
                                {
                                    <p class="mb-1 text-xs text-slate-500">Como usa@(UsoUnidade(poder.Unidade) > 1 ? $" · esta configuração é usada por {UsoUnidade(poder.Unidade)} monstros" : "")</p>
                                    <div class="grid grid-cols-2 gap-3">
                                        <label class="block"><span class="rotulo">Intervalo (ms)</span><input type="number" min="0" max="60000" class="entrada entrada-sm @(MudouUnidade(u) ? "ring-2 ring-amber-400/60" : "")" value="@u.Delay" @onchange="e => u.Delay = Clamp(e, 0, 60000, u.Delay)" aria-label="Intervalo" /></label>
                                        <label class="block"><span class="rotulo">Área</span><input type="number" min="0" max="255" class="entrada entrada-sm @(MudouUnidade(u) ? "ring-2 ring-amber-400/60" : "")" value="@u.Area" @onchange="e => u.Area = Clamp(e, 0, 255, u.Area)" aria-label="Área" /></label>
                                    </div>
                                    @if (u.Efeitos.Count > 0)
                                    {
                                        <p class="mb-1 mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Efeitos</p>
                                        <div class="space-y-2">
                                            @foreach (var eid in u.Efeitos)
                                            {
                                                var ef = EfeitoEdit(eid);
                                                <div class="grid grid-cols-2 items-end gap-2 sm:grid-cols-4">
                                                    @if (ef == null)
                                                    {
                                                        <span class="col-span-2 text-xs text-rose-500">Efeito @eid não está no MonsterSkillElement.txt.</span>
                                                    }
                                                    else
                                                    {
                                                        <label class="col-span-2 block"><span class="rotulo">Efeito@(UsoEfeito(eid) > 1 ? $" · em {UsoEfeito(eid)} unidades" : "")</span>
                                                            <select class="entrada entrada-sm @(MudouEfeito(ef) ? "ring-2 ring-amber-400/60" : "")" @onchange="e => ef.Tipo = IntOr(e, ef.Tipo)">
                                                                @foreach (var t in MonsterSkills.TiposEfeito)
                                                                {
                                                                    <option value="@t.Tipo" selected="@(t.Tipo == ef.Tipo)">@t.Tipo — @t.Nome</option>
                                                                }
                                                                @if (!MonsterSkills.TiposEfeito.Any(t => t.Tipo == ef.Tipo))
                                                                {
                                                                    <option value="@ef.Tipo" selected>@ef.Tipo — (outro)</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label class="block"><span class="rotulo">Chance (%)</span><input type="number" min="0" max="100" class="entrada entrada-sm @(MudouEfeito(ef) ? "ring-2 ring-amber-400/60" : "")" value="@ef.Chance" @onchange="e => ef.Chance = Clamp(e, 0, 100, ef.Chance)" aria-label="Chance" /></label>
                                                        <label class="block"><span class="rotulo">Duração (s)</span><input type="number" min="0" max="60000" class="entrada entrada-sm @(MudouEfeito(ef) ? "ring-2 ring-amber-400/60" : "")" value="@ef.Duracao" @onchange="e => ef.Duracao = Clamp(e, 0, 60000, ef.Duracao)" aria-label="Duração" /></label>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                    <div class="mt-4 flex flex-wrap items-end gap-2 border-t border-slate-200 pt-4 dark:border-white/10">
                        <label class="block"><span class="rotulo">Adicionar poder — skill</span>
                            <select class="entrada entrada-sm w-56 max-w-full" @bind="skillNova">
                                @foreach (var s in SkillsOrdenadas)
                                {
                                    <option value="@s.Key">@s.Value</option>
                                }
                            </select>
                        </label>
                        <label class="block"><span class="rotulo">Como usa (área, intervalo, efeitos)</span>
                            <select class="entrada entrada-sm w-80 max-w-full" @bind="unidadeNova">
                                <option value="-1">— escolher —</option>
                                @foreach (var un in skills.Unidades.Values.OrderBy(x => x.Index))
                                {
                                    <option value="@un.Index">@MonsterSkills.DescreverUnidade(un.Index, skills)</option>
                                }
                            </select>
                        </label>
                        <button type="button" class="btn btn-secundario btn-sm" @onclick="AdicionarPoder" disabled="@(unidadeNova < 0)"><Icone Nome="plus" Classe="h-3.5 w-3.5" />Adicionar</button>
                    </div>
                    <Nota Tipo="atencao" Classe="mt-3">
                        <b>Mudança de poder só vale depois de REINICIAR os GameServers.</b> O "Salvar e recarregar" grava e dá Reload Monster, mas o Reload <b>não relê os poderes</b> — eles são lidos quando o GameServer liga. Então: Salvar aqui → Processos e jogadores → Parar todos → Iniciar todos.
                    </Nota>
                    <p class="ajuda mt-2">O servidor só faz os monstros soltarem as skills da lista (as que o kit usa: ataque básico, Poison, Meteorite, Hell Fire, Lunge, Uppercut e os Summons). <b>Outras skills (Evil Spirit, Twisting Slash…) não são soltadas por monstros</b> sem mexer no GameServer. Cada poder é uma skill + uma configuração (área, intervalo, efeitos).</p>
                </ChildContent>
            </Cartao>
        }
    </div>
</div>

<ResultadoAcao Linhas="resultado" Titulo="atributos dos monstros" Quando="quando" />

@code {
    List<MonsterStats.Monstro> monstros = new();
    MonsterSkills.Dados skills = new();
    MonsterStats.Monstro? atual, editado;
    // edição dos poderes do monstro aberto (cópias, para comparar com o original em skills)
    List<MonsterSkills.Poder> poderesEdit = new();
    Dictionary<int, MonsterSkills.Unidade> unidadesEdit = new();
    Dictionary<int, MonsterSkills.Efeito> efeitosEdit = new();
    int unidadeNova = -1, skillNova = 0;

    // só as skills que o servidor realmente faz os monstros soltarem (as que o kit usa); outras não são soltadas sem mexer no GameServer
    IEnumerable<KeyValuePair<int, string>> SkillsOrdenadas => skills.Skills.Where(x => skills.SkillsDeMonstro.Contains(x.Key)).OrderBy(x => x.Value, StringComparer.CurrentCultureIgnoreCase);
    string filtro = "", carimbo = "";
    bool ocupado;
    List<string> resultado = new();
    DateTime quando;
    IDisposable? trava;

    bool MudouStats => atual != null && editado != null && !atual.Valores.SequenceEqual(editado.Valores);
    bool MudouListaPoderes => atual != null && !poderesEdit.SequenceEqual(skills.PoderesDoMonstro.GetValueOrDefault(atual.Index, new()));
    bool MudouPoderes => MudouListaPoderes
        || unidadesEdit.Values.Any(u => skills.Unidades.TryGetValue(u.Index, out var o) && (o.Delay != u.Delay || o.Area != u.Area))
        || efeitosEdit.Values.Any(e => skills.Efeitos.TryGetValue(e.Index, out var o) && (o.Tipo != e.Tipo || o.Chance != e.Chance || o.Duracao != e.Duracao));
    bool Mudou => MudouStats || MudouPoderes;

    protected override async Task OnInitializedAsync()
    {
        await Carregar();
        trava = Nav.RegisterLocationChangingHandler(async ctx =>
        {
            if (Mudou && !await Confirmar.Perguntar("Sair sem salvar?", $"{atual?.Nome} tem alterações não salvas.", "Sair sem salvar", perigo: true))
                ctx.PreventNavigation();
        });
    }

    public void Dispose() => trava?.Dispose();

    async Task Carregar()
    {
        try
        {
            (monstros, skills, carimbo) = await Task.Run(() => (MonsterStats.Carregar(), MonsterSkills.Carregar(), ExecutorAcoes.Carimbo(Drops.MonsterFile)));
            if (atual != null) { atual = monstros.FirstOrDefault(m => m.Index == atual.Index); editado = atual?.Copia(); if (atual != null) MontarPoderes(atual.Index); }
        }
        catch (Exception ex) { Registro.Erro("monstros.atributos", ex); Toast.Erro(ExecutorAcoes.MensagemDe(ex)); }
    }

    IEnumerable<MonsterStats.Monstro> Filtrados()
    {
        var f = filtro.Trim();
        if (f.Length == 0) return monstros;
        return monstros.Where(m => m.Nome.Contains(f, StringComparison.OrdinalIgnoreCase) || m.Index.ToString() == f || $"nv {m.Valores[3]}" == f || m.Valores[3].ToString() == f);
    }

    async Task Abrir(MonsterStats.Monstro m)
    {
        if (atual?.Index == m.Index) return;
        if (Mudou && !await Confirmar.Perguntar("Descartar as alterações?", $"{atual?.Nome} tem alterações não salvas.", "Descartar", perigo: true)) return;
        atual = m; editado = m.Copia(); MontarPoderes(m.Index);
    }

    void Mudar(MonsterStats.Campo c, ChangeEventArgs e)
    {
        if (editado == null || !int.TryParse(e.Value?.ToString(), out var v)) return;
        editado.Valores[c.Coluna] = Math.Clamp(v, c.Min, c.Max);
    }

    void Descartar() { if (atual != null) { editado = atual.Copia(); MontarPoderes(atual.Index); } }

    // ---------- poderes ----------
    void MontarPoderes(int monstro)
    {
        poderesEdit = new(skills.PoderesDoMonstro.GetValueOrDefault(monstro, new()));
        unidadesEdit = new(); efeitosEdit = new(); unidadeNova = -1; skillNova = 0;
        foreach (var p in poderesEdit) GarantirUnidade(p.Unidade);
    }

    void GarantirUnidade(int u)
    {
        if (unidadesEdit.ContainsKey(u) || !skills.Unidades.TryGetValue(u, out var o)) return;
        var c = o.Copia(); unidadesEdit[u] = c;
        foreach (var e in c.Efeitos) if (!efeitosEdit.ContainsKey(e) && skills.Efeitos.TryGetValue(e, out var oe)) efeitosEdit[e] = oe.Copia();
    }

    MonsterSkills.Unidade? UnidadeEdit(int u) => unidadesEdit.GetValueOrDefault(u);
    MonsterSkills.Efeito? EfeitoEdit(int e) => efeitosEdit.GetValueOrDefault(e);
    int UsoUnidade(int u) => skills.UnidadeUsadaPor.GetValueOrDefault(u);
    int UsoEfeito(int e) => skills.EfeitoUsadoPor.GetValueOrDefault(e);
    bool MudouUnidade(MonsterSkills.Unidade u) => skills.Unidades.TryGetValue(u.Index, out var o) && (o.Delay != u.Delay || o.Area != u.Area);
    bool MudouEfeito(MonsterSkills.Efeito e) => skills.Efeitos.TryGetValue(e.Index, out var o) && (o.Tipo != e.Tipo || o.Chance != e.Chance || o.Duracao != e.Duracao);

    static int Clamp(ChangeEventArgs e, int min, int max, int atual) => int.TryParse(e.Value?.ToString(), out var v) ? Math.Clamp(v, min, max) : atual;
    static int IntOr(ChangeEventArgs e, int atual) => int.TryParse(e.Value?.ToString(), out var v) ? v : atual;

    void TrocarSkill(int i, ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) poderesEdit[i] = poderesEdit[i] with { Tipo = v }; }
    void RemoverPoder(int i) => poderesEdit.RemoveAt(i);
    void AdicionarPoder()
    {
        if (unidadeNova < 0) return;
        if (poderesEdit.Count >= 10) { Toast.Erro("Máximo de 10 poderes por monstro."); return; }
        GarantirUnidade(unidadeNova);
        poderesEdit.Add(new MonsterSkills.Poder(skillNova, unidadeNova));
        unidadeNova = -1; skillNova = 0;
    }

    async Task Salvar()
    {
        if (atual == null || editado == null) return;
        if (MonsterStats.Problema(editado) is { } p) { Toast.Erro(p); return; }

        var alt = new MonsterSkills.Alteracoes();
        foreach (var e in efeitosEdit.Values) if (skills.Efeitos.TryGetValue(e.Index, out var o) && (o.Tipo != e.Tipo || o.Chance != e.Chance || o.Duracao != e.Duracao)) alt.Efeitos[e.Index] = (e.Tipo, e.Chance, e.Duracao);
        foreach (var u in unidadesEdit.Values) if (skills.Unidades.TryGetValue(u.Index, out var o) && (o.Delay != u.Delay || o.Area != u.Area)) alt.Unidades[u.Index] = (u.Delay, u.Area);
        if (MudouListaPoderes) alt.Poderes = (atual.Index, atual.Nome, poderesEdit.ToList());
        bool temPoderes = alt.Efeitos.Count > 0 || alt.Unidades.Count > 0 || alt.Poderes != null;

        if ((alt.Efeitos.Keys.Any(k => UsoEfeito(k) > 1) || alt.Unidades.Keys.Any(k => UsoUnidade(k) > 1)) &&
            !await Confirmar.Perguntar("Efeito/unidade compartilhado", "Uma unidade ou efeito que você mudou é usado por outros monstros — a mudança vale para todos eles.", "Salvar assim", perigo: true)) return;
        if (MudouStats && await Task.Run(() => ExecutorAcoes.Carimbo(Drops.MonsterFile)) != carimbo &&
            !await Confirmar.Perguntar("O arquivo mudou", "Alguém gravou o Monster.txt depois que você abriu. Salvar agora grava por cima.", "Salvar mesmo assim", perigo: true)) return;

        var novo = editado.Copia(); bool salvarStats = MudouStats;
        var mudStats = MonsterStats.Campos.Where(c => novo.Valor(c) != atual.Valor(c)).Select(c => $"{c.Nome} {atual.Valor(c):N0} → {novo.Valor(c):N0}").ToList();
        var linhas = new List<string>();
        ocupado = true;
        try
        {
            if (await Acoes.Executar("monstros.atributos", $"{novo.Index} {novo.Nome}", () =>
                {
                    if (salvarStats) { var (n, bk) = MonsterStats.Salvar(new[] { novo }); linhas.Add(n == 0 ? "Atributos: nada mudou." : $"Atributos: {string.Join("; ", mudStats)} (backup {Path.GetFileName(bk)})."); }
                    if (temPoderes) linhas.AddRange(MonsterSkills.Salvar(alt));
                    if (linhas.Count > 0) linhas.AddRange(Recarga.Recarregar());
                    return linhas;
                }, Politicas.Administrar, $"{string.Join("; ", mudStats)}{(temPoderes ? " [poderes]" : "")}"))
                await Carregar();
        }
        finally { ocupado = false; }
        resultado = linhas; quando = DateTime.Now;
    }
}

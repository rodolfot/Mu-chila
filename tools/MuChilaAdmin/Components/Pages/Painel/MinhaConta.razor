@page "/minha-conta"
@inject ServicoUsuarios Usuarios
@inject AuthenticationStateProvider Auth

<CabecalhoPagina Titulo="Minha conta" Descricao="Seu usuário do painel." Icone="user" />

@if (SenhaOk == "ok")
{
    <Nota Tipo="sucesso" Classe="mb-5">Senha trocada. As outras sessões abertas com a senha antiga foram encerradas.</Nota>
}

@if (u != null)
{
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
        <Cartao Titulo="Dados" Icone="user">
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-slate-500">Usuário</dt><dd class="font-medium text-slate-900 dark:text-white">@u.Login</dd>
                <dt class="text-slate-500">Nome</dt><dd>@u.Nome</dd>
                <dt class="text-slate-500">Papel</dt><dd>@Papeis.Nome(u.Papel)</dd>
                <dt class="text-slate-500">Criado</dt><dd>@u.Criado.ToString("dd/MM/yyyy HH:mm")@(u.CriadoPor != null ? $" por {u.CriadoPor}" : "")</dd>
                <dt class="text-slate-500">Último login</dt><dd>@(u.UltimoLogin?.ToString("dd/MM/yyyy HH:mm") ?? "—")@(u.UltimoIp != null ? $" · IP {MuChilaAdmin.Core.Painel.Ip.Legivel(u.UltimoIp)}" : "")</dd>
            </dl>
        </Cartao>
        <Cartao Titulo="Segurança" Icone="lock">
            <p class="text-sm text-slate-600 dark:text-slate-300">A senha fica guardada só como hash (PBKDF2, 600.000 iterações): nem o painel nem o banco sabem qual é.</p>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-500">
                <li>5 senhas erradas seguidas bloqueiam o usuário por 15 minutos.</li>
                <li>Sem usar o painel por @Cfg.Web.MinutosSessao minutos, ele pede o login de novo.</li>
                <li>Trocar a senha encerra as outras sessões abertas.</li>
            </ul>
            <a href="minha-conta/senha" class="btn btn-primario mt-4" data-enhance-nav="false"><Icone Nome="key" Classe="ico-sm" />Trocar a senha</a>
        </Cartao>
    </div>
}

@code {
    [Inject] Configuracao Cfg { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "senha")] public string? SenhaOk { get; set; }
    Usuario? u;

    protected override async Task OnInitializedAsync()
    {
        var id = Identidade.IdDe((await Auth.GetAuthenticationStateAsync()).User);
        if (id is int i) u = await Task.Run(() => Usuarios.Repositorio.PorId(i));
    }
}

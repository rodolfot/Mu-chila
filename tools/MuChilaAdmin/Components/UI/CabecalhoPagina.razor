@* Título da página (também vai para a aba do navegador), descrição e botões. *@
<PageTitle>@Titulo · Mu Chila Admin</PageTitle>
<div class="mb-5 flex flex-wrap items-end justify-between gap-4">
    <div class="flex min-w-0 items-center gap-3">
        @if (Icone != null)
        {
            <span class="hidden h-11 w-11 shrink-0 place-items-center rounded-xl bg-amber-500/10 text-amber-600 ring-1 ring-inset ring-amber-500/20 sm:grid dark:text-amber-400">
                <Icone Nome="@Icone" Classe="h-6 w-6" />
            </span>
        }
        <div class="min-w-0">
            <h1 class="truncate text-xl font-semibold tracking-tight sm:text-2xl" tabindex="-1">@Titulo</h1>
            @if (Descricao != null)
            {
                <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">@Descricao</p>
            }
        </div>
    </div>
    @if (ChildContent != null)
    {
        <div class="flex flex-wrap items-center gap-2">@ChildContent</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Descricao { get; set; }
    [Parameter] public string? Icone { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<div class="flex flex-col items-center justify-center gap-2 px-4 py-10 text-center">
    <span class="grid h-12 w-12 place-items-center rounded-full bg-slate-100 text-slate-400 dark:bg-white/5 dark:text-slate-500">
        <Icone Nome="@Icone" Classe="h-6 w-6" />
    </span>
    <p class="text-sm font-medium text-slate-700 dark:text-slate-300">@Texto</p>
    @if (!string.IsNullOrEmpty(Detalhe))
    {
        <p class="max-w-md text-xs text-slate-500">@Detalhe</p>
    }
    @ChildContent
</div>

@code {
    [Parameter] public string Texto { get; set; } = "Nada por aqui.";
    [Parameter] public string? Detalhe { get; set; }
    [Parameter] public string Icone { get; set; } = "inbox";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

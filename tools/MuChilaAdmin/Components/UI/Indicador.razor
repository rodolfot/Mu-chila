@* Número em destaque do dashboard. Tom: ouro, verde, azul, vermelho, roxo, cinza. *@
<div class="cartao relative overflow-hidden p-4 @(Href != null ? "transition hover:-translate-y-0.5 hover:shadow-md dark:hover:border-white/20" : "")">
    @if (Href != null)
    {
        <a href="@Href" class="absolute inset-0" aria-label="@Rotulo"></a>
    }
    <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <p class="text-[11px] font-medium uppercase leading-tight tracking-wide text-slate-500 sm:truncate sm:text-xs dark:text-slate-400">@Rotulo</p>
            <p class="mt-1.5 text-2xl font-semibold tabular-nums text-slate-900 dark:text-white">@Valor</p>
            @if (Detalhe != null)
            {
                <p class="mt-1 line-clamp-2 text-xs text-slate-500 sm:truncate">@Detalhe</p>
            }
        </div>
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg @CorIcone">
            <Icone Nome="@Icone" Classe="h-5 w-5" />
        </span>
    </div>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Rotulo { get; set; } = "";
    [Parameter, EditorRequired] public string Valor { get; set; } = "";
    [Parameter] public string? Detalhe { get; set; }
    [Parameter] public string Icone { get; set; } = "stats";
    [Parameter] public string Tom { get; set; } = "ouro";
    [Parameter] public string? Href { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string CorIcone => Tom switch
    {
        "verde" => "bg-emerald-500/10 text-emerald-500 dark:text-emerald-400",
        "azul" => "bg-sky-500/10 text-sky-500 dark:text-sky-400",
        "vermelho" => "bg-rose-500/10 text-rose-500 dark:text-rose-400",
        "roxo" => "bg-violet-500/10 text-violet-500 dark:text-violet-400",
        "cinza" => "bg-slate-500/10 text-slate-500 dark:text-slate-400",
        _ => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
    };
}

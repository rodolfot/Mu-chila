@* Janela (modal) por cima da página. Fecha com Esc, no X ou clicando fora (quando PodeFechar). *@
@if (Aberta)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center p-0 sm:items-center sm:p-4" role="dialog" aria-modal="true" aria-label="@Titulo"
         @onkeydown="Tecla" tabindex="-1">
        <div class="absolute inset-0 bg-slate-950/70 backdrop-blur-[2px]" @onclick="FecharFora"></div>
        <div class="animar-entrada relative flex max-h-[92vh] w-full flex-col rounded-t-2xl border border-slate-200 bg-white shadow-2xl sm:rounded-2xl dark:border-white/10 dark:bg-slate-900 @Largura">
            <header class="flex items-start justify-between gap-4 border-b border-slate-200 px-5 py-4 dark:border-white/10">
                <div class="min-w-0">
                    <h2 class="text-base font-semibold text-slate-900 dark:text-white">@Titulo</h2>
                    @if (Subtitulo != null)
                    {
                        <p class="mt-0.5 text-xs text-slate-500">@Subtitulo</p>
                    }
                </div>
                @if (PodeFechar)
                {
                    <button type="button" class="btn btn-fantasma btn-icone -mr-2 -mt-1" @onclick="Fechar" aria-label="Fechar"><Icone Nome="close" Classe="ico-sm" /></button>
                }
            </header>
            <div class="rolagem min-h-0 flex-1 px-5 py-4">@ChildContent</div>
            @if (Rodape != null)
            {
                <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 bg-slate-50/60 px-5 py-3 dark:border-white/10 dark:bg-white/[0.02] sm:rounded-b-2xl">
                    @Rodape
                </footer>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Aberta { get; set; }
    [Parameter] public EventCallback<bool> AbertaChanged { get; set; }
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    /// <summary>Tamanho: "sm:max-w-md", "sm:max-w-lg" (padrão), "sm:max-w-2xl", "sm:max-w-4xl"...</summary>
    [Parameter] public string Largura { get; set; } = "sm:max-w-lg";
    [Parameter] public bool PodeFechar { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Rodape { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }

    async Task Fechar()
    {
        Aberta = false;
        await AbertaChanged.InvokeAsync(false);
        await AoFechar.InvokeAsync();
    }

    Task FecharFora() => PodeFechar ? Fechar() : Task.CompletedTask;

    Task Tecla(KeyboardEventArgs e) => e.Key == "Escape" && PodeFechar ? Fechar() : Task.CompletedTask;
}
